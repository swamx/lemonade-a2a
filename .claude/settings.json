{
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh api * merge*)",
      "Bash(gh api * reviews*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push * main)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git push * --delete*)"
    ],
    "ask": [
      "Bash(gh api * rulesets*)",
      "Bash(gh api * branches/*/protection*)",
      "Bash(gh repo edit:*)",
      "Bash(gh release create:*)",
      "Bash(git tag:*)"
    ]
  }
}
